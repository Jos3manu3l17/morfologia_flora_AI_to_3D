addNewSpline spline_7
addKnot spline_7 1 #smooth #line [0.000, -0.000, 7.500]
addKnot spline_7 1 #smooth #line [6.017, 6.017, 7.500]
addKnot spline_7 1 #smooth #line [12.035, 12.035, 7.500]
addKnot spline_7 1 #smooth #line [18.052, 18.052, 7.500]
addKnot spline_7 1 #smooth #line [24.070, 24.070, 7.500]
addKnot spline_7 1 #smooth #line [30.087, 30.087, 7.500]
addKnot spline_7 1 #smooth #line [36.104, 36.104, 7.500]
addKnot spline_7 1 #smooth #line [42.122, 42.122, 7.500]
addKnot spline_7 1 #smooth #line [48.139, 48.139, 7.500]
addKnot spline_7 1 #smooth #line [54.156, 54.156, 7.500]
updateShape spline_7

-- Aplicando curvatura natural
addModifier shp (Bend angle:5.0 direction:0 bendAxis:2)

-- Añadiendo detalle de superficie
convertToPoly shp
polyOp.bevelFaces shp #all 0.5 0.2

-- Configuración final
max zoomext sel all

print ("Hoja 3D realista creada: " + shp.name)