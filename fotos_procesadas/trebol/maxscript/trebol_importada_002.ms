addKnot spline_6 1 #smooth #line [0.000, 76.507, 7.500]
addKnot spline_6 1 #smooth #line [0.000, 86.070, 7.500]
updateShape spline_6

-- Nervadura 8
spline_7 = splineShape pos:[0,0,0] name:"venacion_7"
addNewSpline spline_7
addKnot spline_7 1 #smooth #line [0.000, -0.000, 7.500]
addKnot spline_7 1 #smooth #line [6.762, 6.762, 7.500]
addKnot spline_7 1 #smooth #line [13.525, 13.525, 7.500]
addKnot spline_7 1 #smooth #line [20.287, 20.287, 7.500]
addKnot spline_7 1 #smooth #line [27.049, 27.049, 7.500]
addKnot spline_7 1 #smooth #line [33.812, 33.812, 7.500]
addKnot spline_7 1 #smooth #line [40.574, 40.574, 7.500]
addKnot spline_7 1 #smooth #line [47.336, 47.336, 7.500]
addKnot spline_7 1 #smooth #line [54.098, 54.098, 7.500]
addKnot spline_7 1 #smooth #line [60.861, 60.861, 7.500]
updateShape spline_7

-- Aplicando curvatura natural
addModifier shp (Bend angle:5.0 direction:0 bendAxis:2)

-- Añadiendo detalle de superficie
convertToPoly shp
polyOp.bevelFaces shp #all 0.5 0.2

-- Configuración final
max zoomext sel all

print ("Hoja 3D realista creada: " + shp.name)