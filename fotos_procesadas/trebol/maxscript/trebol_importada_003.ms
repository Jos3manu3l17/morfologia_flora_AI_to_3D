addKnot spline_7 1 #smooth #line [0.000, -0.000, 7.500]
addKnot spline_7 1 #smooth #line [6.690, 6.690, 7.500]
addKnot spline_7 1 #smooth #line [13.379, 13.379, 7.500]
addKnot spline_7 1 #smooth #line [20.069, 20.069, 7.500]
addKnot spline_7 1 #smooth #line [26.759, 26.759, 7.500]
addKnot spline_7 1 #smooth #line [33.449, 33.449, 7.500]
addKnot spline_7 1 #smooth #line [40.138, 40.138, 7.500]
addKnot spline_7 1 #smooth #line [46.828, 46.828, 7.500]
addKnot spline_7 1 #smooth #line [53.518, 53.518, 7.500]
addKnot spline_7 1 #smooth #line [60.208, 60.208, 7.500]
updateShape spline_7

-- Aplicando curvatura natural
addModifier shp (Bend angle:5.0 direction:0 bendAxis:2)

-- Añadiendo detalle de superficie
convertToPoly shp
polyOp.bevelFaces shp #all 0.5 0.2

-- Configuración final
max zoomext sel all

print ("Hoja 3D realista creada: " + shp.name)